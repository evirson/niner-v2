          <p class="micro">Sem cartão de crédito. Sem prazo. Você começa a usar em 1 minuto.</p>
        </div>
      </section>
    </main>

    <footer class="rodape">
      <div class="wrap">
        <div class="rodape-grid">
          <div>
            <a class="logo" href="/" style="font-size:22px"><b>Nainer</b></a>
            <p style="margin-top:10px; max-width:26em;">ERP em nuvem para o pequeno varejo brasileiro. Um produto da Vetor Sistemas.</p>
            {contato.cnpjVetor && <p style="margin-top:10px;">CNPJ {contato.cnpjVetor}</p>}
          </div>
          <nav aria-label="Produto">
            <h3>Produto</h3>
            <ul>
              <li><a href="#recursos" data-evento="NAV" data-rotulo="recursos">Recursos</a></li>
              <li><a href="#preco" data-evento="NAV" data-rotulo="preco">Preço</a></li>
              <li><a href="#fiscal" data-evento="NAV" data-rotulo="fiscal">Nota fiscal</a></li>
              <li><a href="#duvidas" data-evento="NAV" data-rotulo="duvidas">Dúvidas</a></li>
            </ul>
          </nav>
          <nav aria-label="Contato">
            <h3>Contato</h3>
            <ul>
              {zap && <li><a href={zap} data-evento="CLIQUE_WHATSAPP" data-rotulo="rodape">WhatsApp</a></li>}
              {insta && <li><a href={insta} data-evento="CLIQUE_INSTAGRAM">Instagram</a></li>}
              {contato.email && <li><a href={`mailto:${contato.email}`}>{contato.email}</a></li>}
            </ul>
          </nav>
          <nav aria-label="Legal">
            <h3>Legal</h3>
            <ul>
              <li><a href="/termos">Termos de uso</a></li>
              <li><a href="/privacidade">Privacidade (LGPD)</a></li>
            </ul>
          </nav>
        </div>
        <p class="legal">© 2026 Vetor Sistemas. Todos os direitos reservados.</p>
      </div>
    </footer>

    <div class="cookies" id="aviso-cookies" role="region" aria-label="Aviso de cookies" hidden>
      <p>Usamos apenas medição própria de audiência, sem rastreadores de terceiros. <a href="/privacidade">Saiba mais</a>.</p>
      <button class="btn btn-secundario" type="button" id="aceitar-cookies">Entendi</button>
    </div>

    <script is:inline>
      // ---- Aviso de cookies: só aparece para quem ainda não dispensou ----------------------
      (function () {
        var aviso = document.getElementById('aviso-cookies');
        var visto = false;
        try {
          visto = localStorage.getItem('ninerCookies') === 'ok';
        } catch (e) {}
        if (!visto) aviso.hidden = false;
        document.getElementById('aceitar-cookies').addEventListener('click', function () {
          aviso.hidden = true;
          try {
            localStorage.setItem('ninerCookies', 'ok');
          } catch (e) {}
        });
      })();

      // ---- Alternador Mensal/Anual ---------------------------------------------------------
      (function () {
        var botoes = document.querySelectorAll('[data-ciclo-btn]');
        botoes.forEach(function (b) {
          b.addEventListener('click', function () {
            var ciclo = b.getAttribute('data-ciclo-btn');
            botoes.forEach(function (o) {
              o.setAttribute('aria-pressed', String(o === b));
            });
            document.querySelectorAll('#tabela-faixas [data-ciclo]').forEach(function (c) {
              c.classList.toggle('ativo', c.getAttribute('data-ciclo') === ciclo);
            });
          });
        });
      })();

      // ---- Preços reais em runtime (GET /api/publico/planos) --------------------------------
      // O HTML já sai com os valores atuais (SEO e API fora do ar); isto corrige quando o dono do
      // produto muda os parâmetros comerciais, sem rebuild do site.
      (function () {
        if (!window.NINER_API_BASE) return;
        var real = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 });
        fetch(window.NINER_API_BASE + '/api/publico/planos')
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (planos) {
            if (!planos) return;
            planos.forEach(function (p) {
              if (p.gratuito || !p.limiteVendasMes) return;
              var mensal = document.querySelector('[data-preco-faixa="' + p.limiteVendasMes + '"][data-ciclo="mensal"]');
              var anual = document.querySelector('[data-preco-faixa="' + p.limiteVendasMes + '"][data-ciclo="anual"]');
              if (mensal) mensal.textContent = real.format(p.precoMensal) + '/mês';
              // Anual é mostrado por mês equivalente: é assim que o lojista compara com o mensal.
              if (anual) anual.textContent = real.format(p.precoAnual / 12) + '/mês';
            });
          })
          .catch(function () {});
      })();
    </script>
  </body>
</html>
