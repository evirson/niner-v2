# macOS
.DS_Store

# Arquivos temporários / scratch
*.log
*.tmp
.scratch/

# Descompactação do padrão de telas (mantém-se só o HTML de referência)
docs/padroes/TELA/
docs/padroes/*.rar

# env local de dev (portas)
.env

# Credenciais de object storage (chave JSON da conta de serviço do GCS) — nunca versionar
api/secrets/
*-service-account*.json

# Massa de teste local da entrada por XML (NF-e reais, 12MB+, com CNPJ/endereço do destinatário) — não versionar
NFE_entradas_teste/

# Certificado digital A1 do lojista (modulo fiscal, F7) — NUNCA versionar.
# Vazamento = terceiro emitindo nota fiscal no CNPJ do lojista.
CERTIFICADO_HOMOLOGACAO/
*.pfx
*.p12

# Credenciais de gateway (Mercado Pago) — NUNCA versionar. Access token/public key vivem em
# variável de ambiente (NINER_MP_ACCESS_TOKEN / NINER_MP_WEBHOOK_SECRET), nunca no repositório.
docs/mercadopago/
*mercadopago*secret*

# Credenciais do Mercado Livre (marketplace) — outra empresa, outra credencial: o `client_id` e o
# `client_secret` da aplicação OAuth. Mesmo tratamento, pasta separada de propósito.
docs/mercadolivre/
*mercadolivre*secret*
